{
  "name": "ark-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "clean:metro": "watchman watch-del-all || true; rm -rf \"${TMPDIR:-/tmp}\"/metro-* \"${TMPDIR:-/tmp}\"/haste-map-*",
    "start:clean": "npm run clean:metro && npm run start:reset",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "android:clean": "cd android; ./gradlew clean; cd ..; npm run android",
    "android:fresh": "npm run clean:metro && cd android && ./gradlew clean && cd .. && npm run android",
    "ios:fresh": "npm run clean:metro && rm -rf ios/build && npm run ios",
    "android:reconnect": "adb reverse tcp:8081 tcp:8081",
    "android:log": "npx react-native log-android",
    "android:asset": "npx react-native-asset",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "axios": "^1.19.0",
    "react": "19.1.0",
    "react-native": "0.80.3",
    "react-native-dotenv": "^4.1.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "5.5.2",
    "react-native-screens": "4.13.1",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.1.2",
    "@react-native-community/cli-platform-android": "19.1.2",
    "@react-native-community/cli-platform-ios": "19.1.2",
    "@react-native/babel-preset": "0.80.3",
    "@react-native/eslint-config": "0.80.3",
    "@react-native/metro-config": "0.80.3",
    "eslint": "^8.19.0",
    "prettier": "2.8.8"
  },
  "engines": {
    "node": ">=18"
  }
}
